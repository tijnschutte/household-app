{
  "$schema": "https://unpkg.com/knip@6/schema.json",

  "ignore": [
    // Vendored shadcn/ui. These files keep the full upstream API on purpose, so an
    // unused export here is not dead code. Deleting one makes the next `shadcn add`
    // re-add it and the diff noisy.
    "src/components/ui/**",
    // The browser loads the service worker by URL, so no module imports it.
    "public/sw.js",
    "public/workbox-*.js",
    "public/swe-worker-*.js",
    "public/worker-*.js"
  ],

  // next-pwa compiles worker/ into the service worker by path, not by import,
  // so nothing in the module graph reaches it.
  "entry": ["worker/index.ts"],

  "ignoreDependencies": [
    // Consumed by config, not by an import: eslint.config.mjs extends
    // eslint-config-next, and tailwind ships CLI binaries.
    "eslint-config-next",
    "tailwindcss-cli",
    "@tailwindcss/forms",
    "tailwindcss-animate",
    // Backs the vendored primitives ignored above.
    "@radix-ui/react-alert-dialog",
    "@radix-ui/react-tooltip",
    // recepten/recipe-form.tsx uses react-hook-form directly but validates
    // with recipeSchema.safeParse rather than the zodResolver adapter.
    "@hookform/resolvers"
  ]
}
