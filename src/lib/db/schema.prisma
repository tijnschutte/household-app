generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int                @id @default(autoincrement())
  name              String             @unique
  password          String
  householdId       Int?
  household         Household?         @relation(fields: [householdId], references: [id])
  groceries         Grocery[]
  categories        Category[]
  pushSubscriptions PushSubscription[]
  notificationMutes NotificationMute[]
  hiddenModules     HiddenModule[]
}

// A tab beside the shared list, which is the one module nobody can switch off.
// Every value here must have an entry in OPTIONAL_MODULES and a route behind
// it, or it is a switch that hides nothing.
enum OptionalModule {
  GELD
  RECEPTEN
}

// A module a user has switched off. Same trade as NotificationMute: storing
// the exceptions means a module added later appears for everyone without a
// backfill, at the cost of arriving unasked for the people who don't want it.
model HiddenModule {
  id     Int            @id @default(autoincrement())
  userId Int
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  module OptionalModule

  @@unique([userId, module])
}

// What a household member can be told about. Every value here must have a
// call site that raises it and an entry in NOTIFICATION_TOPICS, or the topic
// is an unreachable row in the settings screen.
enum NotificationTopic {
  GROCERY_ADDED
  MEMBER_JOINED
}

// One row per device that has granted notification permission — a user signed
// in on a phone and a laptop has two. `endpoint` is the push service's URL for
// that device and is globally unique, so re-subscribing the same device
// updates the keys instead of accumulating rows.
model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// A topic a user has switched off. Storing the exceptions rather than the
// choices means a topic added later reaches everyone without a backfill:
// no row is the default, and the default is "yes, tell me".
model NotificationMute {
  id     Int               @id @default(autoincrement())
  userId Int
  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic  NotificationTopic

  @@unique([userId, topic])
}

model Household {
  id             Int             @id @default(autoincrement())
  name           String          @unique
  secret         String?         @unique
  members        User[]
  Grocery        Grocery[]
  categories     Category[]
  recurringItems RecurringItem[]
  adjustments    Adjustment[]
  recipes        Recipe[]
  ingredients    Ingredient[]
  recipeTags     RecipeTag[]
}

model Category {
  id          Int        @id @default(autoincrement())
  name        String
  household   Household? @relation(fields: [householdId], references: [id])
  householdId Int?
  User        User?      @relation(fields: [userId], references: [id])
  userId      Int?
  groceries   Grocery[]
  updatedAt   DateTime   @default(now()) @updatedAt

  @@unique([name, householdId])
  @@unique([name, userId])
}

model Grocery {
  id          Int             @id @default(autoincrement())
  name        String
  // No default: null means "just the name" — quantity/unit only arrive with an
  // item added from a recipe (see recepten/basket.ts). A hand-typed item has both.
  quantity    Decimal?        @db.Decimal(10, 2)
  unit        String?
  bought      Boolean?        @default(false)
  household   Household?      @relation(fields: [householdId], references: [id])
  householdId Int?
  User        User?           @relation(fields: [userId], references: [id])
  userId      Int?
  category    Category?       @relation(fields: [categoryId], references: [id])
  categoryId  Int?
  // Which recipe last wrote this row's quantity, so the list can show "van
  // {recept}" under it. Never set for a hand-typed row. SetNull rather than
  // Cascade: deleting the recipe should not delete groceries someone still
  // needs to buy — only sever the trace back to where they came from.
  sourceRecipe   Recipe?      @relation(fields: [sourceRecipeId], references: [id], onDelete: SetNull)
  sourceRecipeId Int?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt

  @@unique([name, householdId])
  @@unique([name, userId])
}

// A household's own vocabulary of ingredient names, built up as recipes are
// written. Shared with the shopping list only by name — adding a recipe's
// ingredients to the mandje (recepten/basket.ts) matches on Grocery.name, not
// on this table, so nothing here constrains what a person can type on the list.
model Ingredient {
  id          Int                @id @default(autoincrement())
  householdId Int
  household   Household          @relation(fields: [householdId], references: [id])
  // Stored lowercase and trimmed so the unique constraint dedups regardless of
  // typing, same trade as Grocery.name.
  name        String
  lines       RecipeIngredient[]

  @@unique([householdId, name])
}

// A household's own tags for filtering recipes ("Snel", "Vegetarisch", ...).
// Display case is kept (unlike Ingredient.name) because a tag is read as a
// label, not matched against free text.
model RecipeTag {
  id          Int       @id @default(autoincrement())
  householdId Int
  household   Household @relation(fields: [householdId], references: [id])
  name        String
  recipes     Recipe[]

  @@unique([householdId, name])
}

// A household-shared recipe. Any member may create, edit or delete any
// recipe — there is no per-recipe owner, unlike the two grocery lists.
model Recipe {
  id           Int                @id @default(autoincrement())
  householdId  Int
  household    Household          @relation(fields: [householdId], references: [id])
  title        String
  instructions String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @default(now()) @updatedAt
  ingredients  RecipeIngredient[]
  tags         RecipeTag[]
  // Grocery rows this recipe most recently stamped its quantity onto — see
  // Grocery.sourceRecipeId.
  groceries    Grocery[]

  @@unique([householdId, title])
}

// One ingredient line on a recipe. `position` is the order the form and the
// detail screen show the lines in — insertion order isn't guaranteed to
// survive the wholesale delete-and-recreate an edit does (recepten/actions.ts).
model RecipeIngredient {
  id           Int         @id @default(autoincrement())
  recipeId     Int
  recipe       Recipe      @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId Int
  ingredient   Ingredient  @relation(fields: [ingredientId], references: [id])
  quantity     Decimal?    @db.Decimal(10, 2)
  unit         String?
  position     Int

  @@unique([recipeId, ingredientId])
}

enum RecurringKind {
  CONTRIBUTION
  EXPENSE
}

// A recurring monthly line item in the household pot: either a member's
// contribution (inleg) or a bill paid from the pot (uitgave). "Active" in a
// given month m means activeFrom <= m && (activeTo == null || activeTo >= m).
model RecurringItem {
  id            Int           @id @default(autoincrement())
  householdId   Int
  household     Household     @relation(fields: [householdId], references: [id])
  name          String
  kind          RecurringKind
  expectedCents Int
  activeFrom    String // "YYYY-MM", inclusive
  activeTo      String? // "YYYY-MM", inclusive; null = still active
  entries       MonthEntry[]

  @@unique([householdId, name, kind])
}

// Marks a RecurringItem as paid for a given month. Domain rule: entering an
// amount IS the act of paying — there's no separate "paid" flag.
model MonthEntry {
  id              Int           @id @default(autoincrement())
  recurringItemId Int
  recurringItem   RecurringItem @relation(fields: [recurringItemId], references: [id], onDelete: Cascade)
  month           String // "YYYY-MM"
  amountCents     Int
  paidAt          DateTime      @default(now())

  @@unique([recurringItemId, month])
}

// A one-off correction to the pot for a given month ("rechttrekken"), on top
// of the regular contributions/expenses.
model Adjustment {
  id          Int       @id @default(autoincrement())
  householdId Int
  household   Household @relation(fields: [householdId], references: [id])
  month       String
  amountCents Int // positive adds to the pot, negative removes
  note        String?
  createdAt   DateTime  @default(now())
}
