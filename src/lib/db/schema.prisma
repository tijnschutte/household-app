generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int                @id @default(autoincrement())
  name              String             @unique
  password          String
  householdId       Int?
  household         Household?         @relation(fields: [householdId], references: [id])
  groceries         Grocery[]
  categories        Category[]
  pushSubscriptions PushSubscription[]
  notificationMutes NotificationMute[]
  hiddenModules     HiddenModule[]
}

// A tab beside the shared list, which is the one module nobody can switch off.
// Every value here must have an entry in OPTIONAL_MODULES and a route behind
// it, or it is a switch that hides nothing.
enum OptionalModule {
  GELD
}

// A module a user has switched off. Same trade as NotificationMute: storing
// the exceptions means a module added later appears for everyone without a
// backfill, at the cost of arriving unasked for the people who don't want it.
model HiddenModule {
  id     Int            @id @default(autoincrement())
  userId Int
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  module OptionalModule

  @@unique([userId, module])
}

// What a household member can be told about. Every value here must have a
// call site that raises it and an entry in NOTIFICATION_TOPICS, or the topic
// is an unreachable row in the settings screen.
enum NotificationTopic {
  GROCERY_ADDED
  MEMBER_JOINED
}

// One row per device that has granted notification permission — a user signed
// in on a phone and a laptop has two. `endpoint` is the push service's URL for
// that device and is globally unique, so re-subscribing the same device
// updates the keys instead of accumulating rows.
model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// A topic a user has switched off. Storing the exceptions rather than the
// choices means a topic added later reaches everyone without a backfill:
// no row is the default, and the default is "yes, tell me".
model NotificationMute {
  id     Int               @id @default(autoincrement())
  userId Int
  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic  NotificationTopic

  @@unique([userId, topic])
}

model Household {
  id             Int             @id @default(autoincrement())
  name           String          @unique
  secret         String?         @unique
  members        User[]
  Grocery        Grocery[]
  categories     Category[]
  recurringItems RecurringItem[]
  adjustments    Adjustment[]
}

model Category {
  id          Int        @id @default(autoincrement())
  name        String
  household   Household? @relation(fields: [householdId], references: [id])
  householdId Int?
  User        User?      @relation(fields: [userId], references: [id])
  userId      Int?
  groceries   Grocery[]
  updatedAt   DateTime   @default(now()) @updatedAt

  @@unique([name, householdId])
  @@unique([name, userId])
}

model Grocery {
  id          Int        @id @default(autoincrement())
  name        String
  quantity    Int?       @default(1)
  bought      Boolean?   @default(false)
  household   Household? @relation(fields: [householdId], references: [id])
  householdId Int?
  User        User?      @relation(fields: [userId], references: [id])
  userId      Int?
  category    Category?  @relation(fields: [categoryId], references: [id])
  categoryId  Int?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt

  @@unique([name, householdId])
  @@unique([name, userId])
}

enum RecurringKind {
  CONTRIBUTION
  EXPENSE
}

// A recurring monthly line item in the household pot: either a member's
// contribution (inleg) or a bill paid from the pot (uitgave). "Active" in a
// given month m means activeFrom <= m && (activeTo == null || activeTo >= m).
model RecurringItem {
  id            Int           @id @default(autoincrement())
  householdId   Int
  household     Household     @relation(fields: [householdId], references: [id])
  name          String
  kind          RecurringKind
  expectedCents Int
  activeFrom    String // "YYYY-MM", inclusive
  activeTo      String? // "YYYY-MM", inclusive; null = still active
  entries       MonthEntry[]

  @@unique([householdId, name, kind])
}

// Marks a RecurringItem as paid for a given month. Domain rule: entering an
// amount IS the act of paying — there's no separate "paid" flag.
model MonthEntry {
  id              Int           @id @default(autoincrement())
  recurringItemId Int
  recurringItem   RecurringItem @relation(fields: [recurringItemId], references: [id], onDelete: Cascade)
  month           String // "YYYY-MM"
  amountCents     Int
  paidAt          DateTime      @default(now())

  @@unique([recurringItemId, month])
}

// A one-off correction to the pot for a given month ("rechttrekken"), on top
// of the regular contributions/expenses.
model Adjustment {
  id          Int       @id @default(autoincrement())
  householdId Int
  household   Household @relation(fields: [householdId], references: [id])
  month       String
  amountCents Int // positive adds to the pot, negative removes
  note        String?
  createdAt   DateTime  @default(now())
}
