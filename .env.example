# Database — matches docker-compose.yml (bun run db:up)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mandje"

# NextAuth
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-key-change-this"

# Web Push (VAPID) — without these, notifications are simply off.
# Generate a pair with: bunx web-push generate-vapid-keys
# The public key is deliberately the NEXT_PUBLIC_ one the browser reads, so
# server and client can never subscribe against different keys.
VAPID_SUBJECT="mailto:you@example.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"

# Node Environment
NODE_ENV="development"
