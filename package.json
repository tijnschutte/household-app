{
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:local": "bun run db:up && bun run db:migrate && bun run dev",
    "dev:fresh": "bun run db:up && bun run db:reset && bun run dev",
    "build": "next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint --fix",
    "lint:check": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "knip": "knip",
    "knip:ci": "knip --include dependencies,devDependencies,unlisted,binaries,unresolved",
    "test": "vitest",
    "test:run": "vitest run",
    "e2e": "playwright test",
    "verify": "bun run typecheck && bun run lint:check && bun run format:check && bun run arch && bun run knip:ci && bun run test:run",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:migrate": "bunx prisma migrate dev",
    "db:seed": "bunx prisma db seed",
    "db:reset": "bunx prisma migrate reset --force",
    "db:studio": "bunx prisma studio",
    "prepare": "husky"
  },
  "prisma": {
    "schema": "src/lib/db/schema.prisma",
    "seed": "bun run src/lib/db/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@hookform/resolvers": "^4.1.3",
    "@prisma/client": "^6.5.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.11",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.1.8",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.477.0",
    "next": "15.2.8",
    "next-auth": "5.0.0-beta.25",
    "postcss": "^8.5.3",
    "react": "latest",
    "react-dom": "latest",
    "react-hook-form": "^7.54.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.0.14",
    "typescript": "5.7.3",
    "web-push": "^3.6.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "^4.0.13",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.5",
    "dependency-cruiser": "^18.1.1",
    "eslint": "^9",
    "eslint-config-next": "15.2.8",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.11.1",
    "husky": "^9.1.7",
    "knip": "^6.32.0",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "prisma": "^6.5.0",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-cli": "^0.1.2",
    "vitest": "^4.1.10"
  },
  "trustedDependencies": [
    "@prisma/client",
    "@prisma/engines",
    "esbuild",
    "prisma",
    "sharp",
    "unrs-resolver"
  ]
}
