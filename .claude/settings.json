{
  "permissions": {
    "ask": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/verify-file.sh",
            "timeout": 30,
            "statusMessage": "Running lint, format and typecheck..."
          }
        ]
      }
    ],
    "PostToolBatch": [],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/react-doctor.mjs\""
          }
        ]
      }
    ]
  }
}
